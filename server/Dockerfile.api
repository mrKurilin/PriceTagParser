# syntax=docker/dockerfile:1.7

ARG PRICE_TAG_RUNTIME_IMAGE=eclipse-temurin:21-jre-noble

FROM gradle:8.14.3-jdk21 AS build
WORKDIR /workspace

COPY --chown=gradle:gradle gradlew gradlew.bat settings.gradle.kts build.gradle.kts gradle.properties ./
COPY --chown=gradle:gradle gradle ./gradle
COPY --chown=gradle:gradle server/build.gradle.kts ./server/build.gradle.kts
COPY --chown=gradle:gradle shared/build.gradle.kts ./shared/build.gradle.kts

RUN --mount=type=cache,id=pricetagparser-gradle-cache,target=/home/gradle/.gradle,uid=1000,gid=1000,sharing=locked \
    ./gradlew :server:buildFatJar --no-daemon --parallel --dry-run

COPY --chown=gradle:gradle server/src ./server/src
COPY --chown=gradle:gradle shared/src ./shared/src
COPY --chown=gradle:gradle generate_csv.sh ./generate_csv.sh

RUN --mount=type=cache,id=pricetagparser-gradle-cache,target=/home/gradle/.gradle,uid=1000,gid=1000,sharing=locked \
    ./gradlew :server:buildFatJar --no-daemon --parallel

FROM ${PRICE_TAG_RUNTIME_IMAGE}

EXPOSE 8080
WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    PRICE_TAG_RECOGNITION_DIR=/app/priceTagRecognition \
    PRICE_TAG_RECOGNITION_CKPT=/app/priceTagRecognition/weights/yolo/weights/best.pt \
    CC=/usr/bin/gcc \
    CXX=/usr/bin/g++ \
    VIRTUAL_ENV=/opt/price-tag-venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

ARG PYTORCH_INDEX_URL=
ARG PYTORCH_EXPECT_CUDA=false

RUN --mount=type=cache,id=pricetagparser-pip-cache,target=/root/.cache/pip,sharing=locked \
    apt-get update \
    && java_packages="" \
    && if ! command -v java >/dev/null 2>&1; then java_packages="openjdk-21-jre-headless"; fi \
    && apt-get install -y --no-install-recommends \
        $java_packages \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python-is-python3 \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        git-lfs \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv "$VIRTUAL_ENV" \
    && pip install --upgrade pip setuptools wheel

# Keep PyTorch installation configurable across CUDA and CPU-only machines.
# For CUDA builds set PYTORCH_INDEX_URL to a matching wheel index, e.g. https://download.pytorch.org/whl/cu124.
RUN --mount=type=cache,id=pricetagparser-pip-cache,target=/root/.cache/pip,sharing=locked \
    if [ -n "$PYTORCH_INDEX_URL" ]; then \
        pip install --upgrade torch torchvision torchaudio --index-url "$PYTORCH_INDEX_URL"; \
    elif python -c "import torch, torchvision, torchaudio" >/dev/null 2>&1; then \
        echo "Using preinstalled PyTorch packages"; \
    else \
        pip install torch torchvision torchaudio; \
    fi; \
    PYTORCH_EXPECT_CUDA="$PYTORCH_EXPECT_CUDA" python -c "import os, torch, torchvision, torchaudio; expect_cuda = os.environ.get('PYTORCH_EXPECT_CUDA', 'false').lower() in ('1', 'true', 'yes'); print(f'Installed PyTorch {torch.__version__} with CUDA {torch.version.cuda}; torchvision {torchvision.__version__}; torchaudio {torchaudio.__version__}'); assert not expect_cuda or torch.version.cuda is not None, 'Installed PyTorch is CPU-only while PYTORCH_EXPECT_CUDA=true'"

COPY priceTagRecognition/requirements.txt /app/priceTagRecognition/requirements.txt
RUN --mount=type=cache,id=pricetagparser-pip-cache,target=/root/.cache/pip,sharing=locked \
    pip install -r /app/priceTagRecognition/requirements.txt

COPY --from=build /workspace/server/build/libs/fat.jar /app/app.jar
COPY --from=build /workspace/generate_csv.sh /app/generate_csv.sh
COPY priceTagRecognition /app/priceTagRecognition

# priceTagRecognition/entrypoint.sh is hardcoded to /workspace, so point it to the API image location.
RUN chmod +x /app/generate_csv.sh "$PRICE_TAG_RECOGNITION_DIR/entrypoint.sh" \
    && rm -rf /workspace \
    && ln -s "$PRICE_TAG_RECOGNITION_DIR" /workspace \
    && "$PRICE_TAG_RECOGNITION_DIR/entrypoint.sh" \
    && test -f "$PRICE_TAG_RECOGNITION_CKPT"

ENTRYPOINT ["java","-jar","/app/app.jar"]
